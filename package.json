    "autoprefixer": "10.4.20",
    "decap-cms": "3.17.1",
    "decap-server": "3.11.4",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.35",
    "postcss": "8.4.49",
    "prettier": "3.3.3",
