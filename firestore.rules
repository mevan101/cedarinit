rules_version = '2';

// Cedar Initiative volunteer platform. Every rule here is tested in firebase/tests/rules.test.mjs.
// Roles live on users/{uid}.role: volunteer | manager | issuer | admin.
//   manager: applications, hours, messages.  issuer: also certificates and letters.  admin: everything, incl. roles.
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function myRole() {
      return exists(/databases/$(db)/documents/users/$(me())) ? get(/databases/$(db)/documents/users/$(me())).data.role : 'none';
    }
    function isStaff() { return signedIn() && myRole() in ['manager', 'issuer', 'admin']; }
    function isIssuer() { return signedIn() && myRole() in ['issuer', 'admin']; }
    function isAdmin() { return signedIn() && myRole() == 'admin'; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function str(v, max) { return v is string && v.size() <= max; }

    match /users/{uid} {
      allow read: if signedIn() && (uid == me() || isStaff());
      allow create: if signedIn() && uid == me()
        && request.resource.data.role == 'volunteer'
        && request.resource.data.email == request.auth.token.email;
      allow update: if signedIn() && (
        (uid == me() && !changed().hasAny(['role', 'email', 'created_at']))
        || (isAdmin() && changed().hasOnly(['role']) && request.resource.data.role in ['volunteer', 'manager', 'issuer', 'admin'])
      );
      allow delete: if false;
    }

    match /applications/{id} {
      allow create: if signedIn()
        && request.resource.data.user_id == me()
        && request.resource.data.status == 'new'
        && !('staff_notes' in request.resource.data)
        && str(request.resource.data.opportunity, 80);
      allow read: if signedIn() && (resource.data.user_id == me() || isStaff());
      allow update: if isStaff()
        || (signedIn() && resource.data.user_id == me() && request.resource.data.status == 'withdrawn' && changed().hasOnly(['status', 'updated_at']));
      allow delete: if false;
    }

    match /hours/{id} {
      function validHours() { return request.resource.data.hours is number && request.resource.data.hours > 0 && request.resource.data.hours <= 24; }
      allow create: if signedIn() && validHours()
        && ((request.resource.data.user_id == me() && request.resource.data.status == 'pending') || isStaff());
      allow read: if signedIn() && (resource.data.user_id == me() || isStaff());
      allow update: if isStaff() && validHours();
      allow delete: if signedIn() && resource.data.user_id == me() && resource.data.status == 'pending';
    }

    // Full certificates and letters: the recipient and staff only.
    match /documents/{id} {
      allow read: if signedIn() && (resource.data.user_id == me() || isStaff());
      allow create: if isIssuer() && id.matches('^CI-[0-9]{4}-[2-9A-HJ-NP-Z]{8}$') && request.resource.data.status == 'valid';
      allow update: if isIssuer() && changed().hasOnly(['status', 'revoked_reason']) && request.resource.data.status == 'revoked';
      allow delete: if false;
    }

    // What /verify/ shows. Anyone can fetch one by its exact ID; nobody can list them.
    // Removal letters never get a verification record.
    match /verifications/{id} {
      allow get: if true;
      allow list: if false;
      allow create: if isIssuer() && request.resource.data.kind != 'termination';
      allow update: if isIssuer() && changed().hasOnly(['status']);
      allow delete: if false;
    }

    // Public profile (opt-in), keyed by handle so handles are unique. Written by its owner.
    match /publicProfiles/{handle} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn() && request.resource.data.uid == me() && handle.matches('^[a-z0-9-]{3,40}$');
      allow update: if signedIn() && resource.data.uid == me() && request.resource.data.uid == me();
      allow delete: if signedIn() && resource.data.uid == me();
    }

    // Verified hours and valid credentials shown on public profiles. Written by staff only, so they can't be faked.
    match /publicStats/{uid} {
      allow get: if true;
      allow list: if false;
      allow write: if isStaff();
    }

    match /messages/{id} {
      allow read: if signedIn() && (resource.data.user_id == me() || isStaff());
      allow create: if isStaff();
      allow update, delete: if false;
    }

    // Outbox for the "Trigger Email" Firebase extension (optional). Staff can queue, nobody can read.
    match /mail/{id} {
      allow create: if isStaff();
      allow read, update, delete: if false;
    }
  }
}
