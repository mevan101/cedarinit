# Endpoint the contact form posts to (multipart/form-data, Contact Form 7 field names).
# Defaults to the existing CF7 form (ID 2674), which writes submissions to Google Sheets.
NEXT_PUBLIC_CONTACT_ENDPOINT=https://cedar-initiative.org/wp-json/contact-form-7/v1/contact-forms/2674/feedback

# Volunteer platform on Firebase (accounts, applications, hours, certificates). Leave empty to run the in-browser demo.
# Firebase console > Project settings > General > Your apps > Web app. These values are public by design.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Local testing only: connect to `firebase emulators:start`
NEXT_PUBLIC_FIREBASE_EMULATOR=
# Show draft articles, pages, programs and reports (preview builds only)
NEXT_PUBLIC_SHOW_DRAFTS=
