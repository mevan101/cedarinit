{
  "name": "cedarinit",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write ."
  },
  "dependencies": {
    "next": "14.0.0",
    "react": "18.0.0",
    "react-dom": "18.0.0",
    "tailwindcss": "^3.0.0",
    "shadcn/ui": "^1.0.0",
    "next-auth": "^4.0.0",
    "prisma": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "@types/node": "^18.0.0",
    "typescript": "^5.0.0",
    "eslint": "^8.0.0",
    "prettier": "^2.0.0",
    "jest": "^29.0.0",
    "react-testing-library": "^13.0.0",
    "playwright": "^1.0.0"
  },
  "eslintConfig": {
    "extends": "next/core-web-vitals"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.ts?(x)": [
      "eslint --fix"
    ],
    "*.js?(x)": [
      "eslint --fix"
    ],
    "*.css": [
      "prettier --write"
    ]
  }
}