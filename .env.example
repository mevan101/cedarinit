# Endpoint the contact form posts to (multipart/form-data, Contact Form 7 field names).
# Defaults to the existing CF7 form (ID 2674), which writes submissions to Google Sheets.
NEXT_PUBLIC_CONTACT_ENDPOINT=https://cedar-initiative.org/wp-json/contact-form-7/v1/contact-forms/2674/feedback

# Volunteer platform on Supabase (accounts, applications, hours, certificates). Leave empty to run the in-browser demo.
# These two values are public by design; row-level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://jczodfunfnbixlmdhgqr.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_b_O_xFWCq_InubnEiBLRSg_7d-t96ex
# Show draft articles, pages, programs and reports (preview builds only)
NEXT_PUBLIC_SHOW_DRAFTS=

# Path prefix when the site is not served from the domain root.
# GitHub Pages sets this to /cedarinit. Leave empty for cedar-initiative.org and local dev.
NEXT_PUBLIC_BASE_PATH=
